plot(c(goog200,rep(NA,16)),type="l",xlab = "Day", ylab="Closing Price (US$)",main="Google stock (daily ending 6 Dec 2013)",ylim = c(350,600))
points(c(rep(NA,length(goog200)),as.data.frame(snaive.goog)[,1]),type="l",col="blue")

