### This file is to create and plot graphs that will be helpfull visual aids in statistical forecast training ###
library(fpp)
library(fpp2)
library(ggplot2)
library(forecast)
library(dplyr)
install.packages("tsfeatures")
library(tsfeatures)
#max_level_shift(goog200) #level shift

# Set training data from 1992 to 2007
beer2 <- window(ausbeer,start=1992,end=c(2007,4))
# Plot some forecasts
autoplot(beer2) +
  autolayer(meanf(beer2, h=11),
            series="Mean", PI=FALSE) +
  autolayer(naive(beer2, h=11),
            series="Naïve", PI=FALSE) +
  autolayer(snaive(beer2, h=11),
            series="Seasonal naïve", PI=FALSE) +
  ggtitle("Forecasts for quarterly beer production") +
  xlab("Year") + ylab("Megalitres") +
  guides(colour=guide_legend(title="Forecast"))

plot(beer2,type="l",xlab = "Year", ylab="Megalitres",main="Quarterly beer production")
fcast.beer=forecast(ausbeer, h=8)
plot(c(beer2,rep(NA,8)),type="l",xlab = "Year", ylab="Megalitres",main="Forecasts for quarterly beer production")
points(c(rep(NA,length(beer2)),as.data.frame(fcast.beer)[,1]),type="l",col="blue")
legend("topright", legend=c("Historical Data", "Forecast"),lty = c(1,1),cex=1.5, col = c("black","blue"),  
       text.col = c("black","blue") 
)

#seasonplot? just for fun

autoplot(goog200) +
  autolayer(meanf(goog200, h=40),
            series="Mean", PI=FALSE) +
  autolayer(rwf(goog200, h=40),
            series="Naïve", PI=FALSE) +
  autolayer(rwf(goog200, drift=TRUE, h=40),
            series="Drift", PI=FALSE) +
  ggtitle("Google stock (daily ending 6 Dec 2013)") +
  xlab("Day") + ylab("Closing Price (US$)") +
  guides(colour=guide_legend(title="Forecast"))

max_level_shift(goog200)

fcast.goog=forecast(goog200, h=8)
plot(c(goog200,rep(NA,8)),type="l",xlab = "Day", ylab="Closing Price (US$)",main="Google stock (daily ending 6 Dec 2013)",ylim = c(350,600))
points(c(rep(NA,length(goog200)),as.data.frame(fcast.goog)[,1]),type="l",col="blue")

#### Decomposition ####
beer.decomp <- decompose(beer2)
plot(beer.decomp)
goog.decomp <- decompose(ts(goog200,frequency = 2))#gives error without the frequency=2 because there is no season. This is just to illustrate a point
plot(goog.decomp)

#### Naive ####
naive.goog=naive(goog200, h=16)
naive.beer=naive(beer2, h=8)
par(mfrow = c(2, 1))
plot(c(beer2,rep(NA,8)),type="l",xlab = "Year", ylab="Megalitres",main="Quarterly beer production")
points(c(rep(NA,length(beer2)),as.data.frame(naive.beer)[,1]),type="l",col="blue")
plot(c(goog200,rep(NA,16)),type="l",xlab = "Day", ylab="Closing Price (US$)",main="Google stock (daily ending 6 Dec 2013)",ylim = c(350,600))
points(c(rep(NA,length(goog200)),as.data.frame(naive.goog)[,1]),type="l",col="blue")

#### Seasonal Naive ####
